
configfile: "workflow/config/config.yaml"

accs = config['accessions']
provider = config['provider']
tools = config['tools']
hostnames = config['hostnames']



def load_fedflow_config(toml_path):
    import rtoml
    with open(toml_path, "r") as f:
        conf = rtoml.load(f)
    # get fc users
    fc_users = []
    for cl in conf['clients']:
        fc_users.append(cl['fc_username'])
    return fc_users


users_fed = load_fedflow_config(f'configs/{provider}/{tools[0]}/config_fed.toml')
users_cent = load_fedflow_config(f'configs/{provider}/{tools[0]}/config_cent.toml')



