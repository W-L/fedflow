rule rulegraph:
    output: "figs/rulegraph.png"
    shell:
        """
        snakemake --rulegraph | dot -Tpng -Gdpi=300 > {output}
        """


rule prep_data_federated:
    output:
        "data/{tool}/{acc}/input.csv"
    wildcard_constraints:
        acc="P[^/]*"   # accession pattern starting with 'P'
    shell:
        "python workflow/scripts/prep_data_federated.py "
        " --acc {wildcards.acc} "
        " --tool {wildcards.tool} "



rule prep_data_centralized:
    input:
        expand("data/{{tool}}/{acc}/input.csv", acc=accs),
    output:
        "data/{tool}/cent/input.csv"
    params:
        accession_list=' '.join(accs),
    shell:
        "python workflow/scripts/prep_data_centralised.py "
        " --tool {wildcards.tool} "
        " --accs {params.accession_list} "



rule distribute_hostnames:
    input:
        expand("configs/{provider}/{tool}/config_{mode}.toml", provider=provider, tool=tools, mode=['fed', 'cent']),
    output:
        'results/hostnames_distributed'
    params:
        provider=provider,
        hostnames=hostnames,
    shell:
        "python workflow/scripts/distribute_hostnames.py "
        " --config_paths 'configs/{provider}/*/*.toml' "
        " --hostnames {params.hostnames} "
        " --out {output} "



rule fedflow_federated:  
    input:
        expand("data/{{tool}}/{acc}/input.csv", acc=accs),
        'results/hostnames_distributed'
    output:
        expand("results/{{provider}}/{{tool}}/fed/results_{u}.zip", u=users_fed),
    resources:
        serial=1,
    shell:
        "fedflow -c configs/{wildcards.provider}/{wildcards.tool}/config_fed.toml"
        


rule fedflow_centralized:  
    input:
        "data/{tool}/cent/input.csv",
        'results/hostnames_distributed'
    output:
        expand("results/{{provider}}/{{tool}}/cent/results_{u}.zip", u=users_cent),
    resources:
        serial=1,
    shell:
        "fedflow -c configs/{wildcards.provider}/{wildcards.tool}/config_cent.toml"



rule unzip_fedflow:
    input:
        "results/{p}/{t}/{m}/results_{u}.zip",
    output:
        "results/{p}/{t}/{m}/{u}/some/output.csv",
    shell:
        "unzip -o {input} -d results/{wildcards.p}/{wildcards.t}/{wildcards.m}/{wildcards.u}/"



use rule unzip_fedflow as unzip_fedflow_svd with:
    output:
        "results/{p}/{t}/{m}/{u}/pca/localData.csv",



use rule unzip_fedflow as unzip_fedflow_randfor with:
    output:
        "results/{p}/{t}/{m}/{u}/pred.csv",
        "results/{p}/{t}/{m}/{u}/proba.csv",
        "results/{p}/{t}/{m}/{u}/test.csv",



rule combine_federated_svd:
    input:
        expand("results/{{p}}/federated-svd/fed/{u}/pca/localData.csv", u=users_fed),
    output:
        "results/{p}/federated-svd/fed/combined_svd.csv",
    params: accessions=accs,
    shell:
        "python workflow/scripts/combine_federated_svd.py "
        " --input {input} "
        " --output {output} "
        " --accessions {params.accessions} "



rule combine_federated_randfor:
    input:
        pred=expand("results/{{p}}/random-forest/fed/{u}/pred.csv", u=users_fed),
        prob=expand("results/{{p}}/random-forest/fed/{u}/proba.csv", u=users_fed),
        true=expand("results/{{p}}/random-forest/fed/{u}/test.csv", u=users_fed),
    output:
        "results/{p}/random-forest/fed/combined_randfor.csv",
    params: accessions=accs,
    shell:
        "python workflow/scripts/combine_federated_randfor.py "
        " --input_pred {input.pred} "
        " --input_prob {input.prob} "
        " --input_true {input.true} "
        " --output {output} "
        " --accessions {params.accessions} "


rule create_figure:
    input:
        svd_cent = expand("results/{{provider}}/federated-svd/cent/{user}/pca/localData.csv", user=users_cent),
        svd_fed = "results/{provider}/federated-svd/fed/combined_svd.csv",
        rf_cent_pred = expand("results/{{provider}}/random-forest/cent/{user}/pred.csv", user=users_cent),
        rf_cent_proba = expand("results/{{provider}}/random-forest/cent/{user}/proba.csv", user=users_cent),
        rf_cent_test = expand("results/{{provider}}/random-forest/cent/{user}/test.csv", user=users_cent),
        rf_fed = "results/{provider}/random-forest/fed/combined_randfor.csv",
        rulegraph = "figs/rulegraph.png",
    output:
        "figs/fig_results_{provider}.png",
    shell:
        "Rscript workflow/scripts/create_fig.r {input.svd_cent} {input.svd_fed} "
        " {input.rf_cent_pred} {input.rf_cent_proba} {input.rf_cent_test} {input.rf_fed} " 
        " {input.rulegraph} {output} "


