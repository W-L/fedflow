
configfile: "workflow/config/config_appnote.yaml"

ds_features = config['downsample_features']
accs = config['accessions']
providers = config['providers']
tools = config['tools']
hostnames = config['biosphere_hostnames']



def load_fedflow_config(toml_path):
    import rtoml
    with open(toml_path, "r") as f:
        conf = rtoml.load(f)
    # get fc users
    fc_users = []
    for cl in conf['clients']:
        fc_users.append(cl['fc_username'])
    # project id
    pid = conf['project_id']
    return pid, fc_users


_, users_fed = load_fedflow_config('configs/biosphere/federated-svd/config_fedsim_fed.toml')
_, users_cent = load_fedflow_config('configs/biosphere/federated-svd/config_fedsim_cent.toml')




