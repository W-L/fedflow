rule rulegraph:
    output: "figs/rulegraph.png"
    shell:
        """
        snakemake --rulegraph | dot -Tpng -Gdpi=300 > {output}
        """

rule download_data:
    output:
        meta="data/metadata_2340_CRC_cohort_20240704.csv",
        msp="data/species_signal_2340_CRC_cohort_20240617_combat_prev0.csv",
    shell:
        "python workflow/scripts/download_data.py"



rule prep_data_federated_svd:
    input:
        meta=rules.download_data.output.meta,
        msp=rules.download_data.output.msp,
    output:
        "data/federated-svd/fed/{acc}/000/input.csv"
    wildcard_constraints:
        acc="P[^/]*"   # accession pattern starting with 'P'
    shell:
        "python workflow/scripts/prep_data_federated_svd.py "
        " --acc {wildcards.acc} "
        " --msp {input.msp} "
        " --meta {input.meta} "


rule prep_data_federated_randfor:
    input:
        meta=rules.download_data.output.meta,
        msp=rules.download_data.output.msp,
    output:
        expand("data/random-forest/fed/{{acc}}/{rep}/input.csv", rep=reps),
    wildcard_constraints:
        acc="P[^/]*"   # accession pattern starting with 'P'
    params:
        n_repeats=n_repeats,
    shell:
        "python workflow/scripts/prep_data_federated_randfor.py "
        " --acc {wildcards.acc} "
        " --msp {input.msp} "
        " --meta {input.meta} "
        " --nrep {params.n_repeats} "




rule prep_data_centralized_svd:
    input:
        expand("data/federated-svd/fed/{acc}/000/input.csv", acc=accs),
    output:
        "data/federated-svd/cent/P0/000/input.csv"
    params:
        accession_list=' '.join(accs),
    shell:
        "python workflow/scripts/prep_data_centralised_svd.py "
        " --accs {params.accession_list} "


rule prep_data_centralized_randfor:
    input:
        expand("data/random-forest/fed/{acc}/{rep}/input.csv", acc=accs, rep=reps),
    output:
        expand("data/random-forest/cent/P0/{rep}/input.csv", rep=reps),
    params:
        accession_list=' '.join(accs),
        n_repeats=n_repeats,
    shell:
        "python workflow/scripts/prep_data_centralised_randfor.py "
        " --accs {params.accession_list} "
        " --nreps {params.n_repeats} "


rule generate_fedflow_config:
    input:
        template="config_templates/{provider}/{tool}/{mode}/config.toml",
        app_config="config_templates/{provider}/{tool}/app/config.yml",
        data_fed_svd=expand("data/federated-svd/fed/{acc}/000/input.csv", acc=accs),
        data_fed_randfor=expand("data/random-forest/fed/{acc}/{{rep}}/input.csv", acc=accs),
        data_cent_svd=rules.prep_data_centralized_svd.output,
        data_cent_randfor=rules.prep_data_centralized_randfor.output,
    output:
        "configs/{provider}/{tool}/{mode}/{rep}/config.toml"
    params:
        accessions=" ".join(accs),
        fc_usernames=" ".join(fc_usernames),
        provider_username=provider_username,
        provider_sshkey=provider_sshkey,
        provider_hostnames=" ".join(provider_hostnames),
        debug_nodeps_flag=" --debug-nodeps" if debug_nodeps else "",
    shell:
        "python workflow/scripts/generate_fedflow_config.py "
        " --template {input.template} "
        " --app-config {input.app_config} "
        " --output {output} "
        " --provider {wildcards.provider} "
        " --tool {wildcards.tool} "
        " --mode {wildcards.mode} "
        " --rep {wildcards.rep} "
        " --accessions {params.accessions} "
        " --fc-usernames {params.fc_usernames} "
        " --provider-username '{params.provider_username}' "
        " --provider-sshkey '{params.provider_sshkey}' "
        " --hostnames {params.provider_hostnames} "
        "{params.debug_nodeps_flag} "



rule fedflow_federated:  
    input:
        "configs/{provider}/{tool}/fed/{rep}/config.toml"
    output:
        expand("results/{{provider}}/{{tool}}/fed/{{rep}}/results_{u}.zip", u=users_fed),
    resources:
        serial=1,
    shell:
        "fedflow -c {input}"


rule fedflow_centralized:  
    input:
        "configs/{provider}/{tool}/cent/{rep}/config.toml"
    output:
        expand("results/{{provider}}/{{tool}}/cent/{{rep}}/results_{u}.zip", u=users_cent),
    resources:
        serial=1,
    shell:
        "fedflow -c {input}"




rule unzip_fedflow:
    input:
        "results/{p}/{t}/{m}/{n}/results_{u}.zip",
    output:
        "results/{p}/{t}/{m}/{n}/{u}/some/output.csv",
    shell:
        "unzip -o {input} -d results/{wildcards.p}/{wildcards.t}/{wildcards.m}/{wildcards.n}/{wildcards.u}/"



use rule unzip_fedflow as unzip_fedflow_svd with:
    output:
        "results/{p}/{t}/{m}/{n}/{u}/pca/localData.csv",



use rule unzip_fedflow as unzip_fedflow_randfor with:
    output:
        "results/{p}/{t}/{m}/{n}/{u}/pred.csv",
        "results/{p}/{t}/{m}/{n}/{u}/proba.csv",
        "results/{p}/{t}/{m}/{n}/{u}/test.csv",



rule combine_federated_svd:
    input:
        expand("results/{{p}}/federated-svd/fed/000/{u}/pca/localData.csv", u=users_fed),
    output:
        "results/{p}/federated-svd/fed/000/combined_svd.csv",
    params: accessions=accs,
    shell:
        "python workflow/scripts/combine_federated_svd.py "
        " --input {input} "
        " --output {output} "
        " --accessions {params.accessions} "



rule combine_federated_randfor:
    input:
        pred=expand("results/{{p}}/random-forest/fed/{{n}}/{u}/pred.csv", u=users_fed),
        prob=expand("results/{{p}}/random-forest/fed/{{n}}/{u}/proba.csv", u=users_fed),
        true=expand("results/{{p}}/random-forest/fed/{{n}}/{u}/test.csv", u=users_fed),
    output:
        "results/{p}/random-forest/fed/{n}/combined_randfor.csv",
    params: accessions=accs,
    shell:
        "python workflow/scripts/combine_federated_randfor.py "
        " --input_pred {input.pred} "
        " --input_prob {input.prob} "
        " --input_true {input.true} "
        " --output {output} "
        " --accessions {params.accessions} "


rule aggregate_randfor_stats:
    input:
        cent_proba=expand("results/{{p}}/random-forest/cent/{r}/{u}/proba.csv", r=reps, u=users_cent),
        cent_test=expand("results/{{p}}/random-forest/cent/{r}/{u}/test.csv", r=reps, u=users_cent),
        fed_combined=expand("results/{{p}}/random-forest/fed/{r}/combined_randfor.csv", r=reps),
    output:
        auc_long="results/{p}/random-forest/stats/auc_long.csv",
        paired_auc="results/{p}/random-forest/stats/paired_auc.csv",
        paired_summary="results/{p}/random-forest/stats/paired_summary.csv",
        wilcoxon="results/{p}/random-forest/stats/wilcoxon.csv",
        roc_aggregate="results/{p}/random-forest/stats/roc_aggregate.csv",
        proba_all="results/{p}/random-forest/stats/proba_all.csv",
        ppscatter="results/{p}/random-forest/stats/ppscatter.csv",
    params:
        cent_prefix="results/{p}/random-forest/cent",
        fed_prefix="results/{p}/random-forest/fed",
        output_prefix="results/{p}/random-forest/stats",
    shell:
        "python workflow/scripts/analyze_randfor_stats.py "
        " --cent-prefix {params.cent_prefix} "
        " --fed-prefix {params.fed_prefix} "
        " --output-prefix {params.output_prefix} "




rule create_figure:
    input:
        svd_cent = expand("results/{{p}}/federated-svd/cent/000/{u}/pca/localData.csv", u=users_cent),
        svd_fed = "results/{p}/federated-svd/fed/000/combined_svd.csv",
        rf_auc_long = rules.aggregate_randfor_stats.output.auc_long,
        rf_paired_summary = rules.aggregate_randfor_stats.output.paired_summary,
        rf_wilcoxon = rules.aggregate_randfor_stats.output.wilcoxon,
        rf_roc_aggregate = rules.aggregate_randfor_stats.output.roc_aggregate,
        rf_proba_all = rules.aggregate_randfor_stats.output.proba_all,
        rf_ppscatter = rules.aggregate_randfor_stats.output.ppscatter,
        rulegraph = "figs/rulegraph.png",
    output:
        "figs/fig_results_{p}.png",
    shell:
        "Rscript workflow/scripts/create_fig.r {input.svd_cent} {input.svd_fed} "
        " {input.rf_auc_long} {input.rf_paired_summary} {input.rf_wilcoxon} {input.rf_roc_aggregate} "
        " {input.rf_proba_all} {input.rf_ppscatter} "
        " {input.rulegraph} {output} "


