import sys
configfile: "workflow/config/config.yaml"

accs = config['accessions']
fc_usernames = config['fc_usernames']
assert len(fc_usernames) >= len(accs)

users_fed = fc_usernames[:len(accs)]
users_cent = [fc_usernames[0]]

providers = config['providers']
p = list(providers.keys())[0]
provider_username = providers[p]['username']  
provider_sshkey = providers[p].get('sshkey', None)
provider_hostnames = providers[p].get('hostnames', [])

tools = config['tools']
n_repeats = config['n_repeats']
reps = [f"{n:03d}" for n in range(n_repeats)]  

debug_nodeps = config.get('debug_nodeps', False)

 

